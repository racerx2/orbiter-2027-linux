# not upstream: copy_directory into the tree Orbiter runs from that keeps a file changed there (an add-on's Config/Earth.cfg)
# cmake -DSTATE=<dir> -P copynewer.cmake <src> <dst>: copies a file missing or unchanged since its last copy; an unknown file only when older

math(EXPR _n "${CMAKE_ARGC} - 2")
set(src "${CMAKE_ARGV${_n}}")
math(EXPR _n "${CMAKE_ARGC} - 1")
set(dst "${CMAKE_ARGV${_n}}")
string(REGEX REPLACE "/+$" "" src "${src}")
string(REGEX REPLACE "/+$" "" dst "${dst}")
if(NOT IS_DIRECTORY "${src}" OR NOT STATE)
	message(FATAL_ERROR "copynewer.cmake: usage cmake -DSTATE=<dir> -P copynewer.cmake <src dir> <dst dir>")
endif()

string(MD5 _key "${src}|${dst}")
set(state "${STATE}/${_key}.txt")
if(EXISTS "${state}")
	file(STRINGS "${state}" _known)
	foreach(_l IN LISTS _known)
		string(SUBSTRING "${_l}" 0 32 _h)
		string(SUBSTRING "${_l}" 33 -1 _s)
		set(K_${_h} "${_s}")
	endforeach()
endif()

function(stamp f out)
	file(TIMESTAMP "${f}" _t "%s" UTC)
	file(SIZE "${f}" _z)
	set(${out} "${_t}:${_z}" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE files LIST_DIRECTORIES true RELATIVE "${src}" "${src}/*")
file(MAKE_DIRECTORY "${dst}")
set(_out "")
foreach(f IN LISTS files)
	set(d "${dst}/${f}")
	if(IS_DIRECTORY "${src}/${f}")
		file(MAKE_DIRECTORY "${d}")
		continue()
	endif()
	string(MD5 _h "${f}")
	set(copy FALSE)
	set(kept FALSE)
	if(NOT EXISTS "${d}")
		set(copy TRUE)
	elseif(DEFINED K_${_h})
		stamp("${d}" _s)
		if("${_s}" STREQUAL "${K_${_h}}")
			set(copy TRUE)
		else()
			file(SHA1 "${src}/${f}" _a)
			file(SHA1 "${d}" _b)
			if(NOT _a STREQUAL _b)
				set(kept TRUE)
				set(_s "${K_${_h}}")
			endif()
		endif()
	else()
		file(SHA1 "${src}/${f}" _a)
		file(SHA1 "${d}" _b)
		if(_a STREQUAL _b)
			stamp("${d}" _s)
		elseif("${src}/${f}" IS_NEWER_THAN "${d}")
			set(copy TRUE)
		else()
			set(kept TRUE)
			set(_s "changed")
		endif()
	endif()
	if(copy)
		get_filename_component(_dir "${d}" DIRECTORY)
		file(MAKE_DIRECTORY "${_dir}")
		file(COPY_FILE "${src}/${f}" "${d}" ONLY_IF_DIFFERENT)
		stamp("${d}" _s)
	endif()
	if(kept)
		message(STATUS "Kept ${d}: changed in the build tree")
	endif()
	string(APPEND _out "${_h} ${_s}\n")
endforeach()
file(MAKE_DIRECTORY "${STATE}")
file(WRITE "${state}" "${_out}")
