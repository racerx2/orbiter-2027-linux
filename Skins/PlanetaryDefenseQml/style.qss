/* Planetary Defense: the classic pages opened from the skin, in its colours; colours, borders and backgrounds only */
QWidget { background-color: #040a14; color: #e6f6ff; selection-background-color: #2a8bff; selection-color: #ffffff; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QWidget#IDC_BLACKBOX { background-color: #000000; color: #b0b0f0; }
QPushButton { background-color: #071222; border: 1px solid #1b6f94; border-radius: 6px; }
QPushButton:hover { background-color: #0c1d33; border-color: #27d3ff; }
QPushButton:pressed, QPushButton:checked { background-color: #2a8bff; color: #ffffff; border-color: #55a6ff; }
QPushButton:disabled { color: #4f6a7c; border-color: #10283a; }
QPushButton#IDLAUNCH { background-color: #2a8bff; color: #ffffff; border-color: #7fe6ff; font-weight: bold; }
QPushButton#IDLAUNCH:hover { background-color: #55a6ff; }
QPushButton#IDLAUNCH:disabled { background-color: #12243a; color: #4f6a7c; border-color: #1b3a52; }
QPushButton#customSkinBack { background-color: #2a8bff; color: #ffffff; border: 1px solid #7fe6ff; border-radius: 10px; padding: 3px 12px; }
QPushButton#customSkinBack:hover { background-color: #55a6ff; }
QTreeView, QListView, QTextEdit, QPlainTextEdit, QTextBrowser { background-color: #030810; border: 1px solid #1b5a78; alternate-background-color: #071222; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background-color: #030810; border: 1px solid #1b5a78; border-radius: 3px; }
QComboBox QAbstractItemView { background-color: #030810; border: 1px solid #1b5a78; }
QGroupBox { border: 1px solid #1b5a78; margin-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 3px; color: #8fb4c8; }
QTabBar::tab { background-color: #071222; border: 1px solid #1b5a78; padding: 3px 8px; }
QTabBar::tab:selected { background-color: #0c1d33; border-bottom: 2px solid #27d3ff; }
QHeaderView::section { background-color: #071222; border: 1px solid #1b5a78; }
QScrollBar:vertical { background: #030810; width: 12px; }
QScrollBar::handle:vertical { background: #1b5a78; min-height: 24px; border-radius: 4px; }
QScrollBar:horizontal { background: #030810; height: 12px; }
QScrollBar::handle:horizontal { background: #1b5a78; min-width: 24px; border-radius: 4px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; }
QProgressBar { background-color: #030810; border: 1px solid #1b5a78; }
QProgressBar::chunk { background-color: #39ff7a; }
QToolTip { background-color: #071222; color: #e6f6ff; border: 1px solid #27d3ff; }
