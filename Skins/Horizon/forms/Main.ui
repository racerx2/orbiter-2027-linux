  <property name="windowTitle">
   <string>Horizon</string>
  </property>
  <property name="styleSheet">
   <string>/* Horizon launcher style sheet.
   It begins with a reset: the classic pages' style sheet on the Launchpad reaches these widgets too. */
QWidget { background: transparent; border: none; border-radius: 0px; margin: 0px; padding: 0px; color: #eef3fb;
  selection-background-color: #f5a524; selection-color: #1b1203; font-family: &quot;Noto Sans&quot;; font-size: 14px; font-weight: 400; }
QPushButton, QPushButton:hover, QPushButton:pressed, QPushButton:checked, QPushButton:disabled, QPushButton:focus,
QToolButton, QToolButton:hover, QToolButton:pressed, QToolButton:checked, QToolButton:disabled {
  background: transparent; border: none; border-radius: 0px; margin: 0px; padding: 0px; color: #eef3fb; }
QCheckBox, QCheckBox:hover, QCheckBox:disabled { background: transparent; border: none; margin: 0px; padding: 0px; spacing: 0px; color: #eef3fb; }
QLineEdit, QLineEdit:focus, QLineEdit:hover, QLineEdit:disabled { background: transparent; border: none; border-radius: 0px; margin: 0px; padding: 0px;
  color: #eef3fb; selection-background-color: #f5a524; selection-color: #1b1203; placeholder-text-color: #657286; }
QScrollArea, QStackedWidget { background: transparent; border: none; }
QScrollBar:vertical, QScrollBar:horizontal { background: transparent; width: 0px; height: 0px; border: none; }
QGroupBox, QGroupBox::title { background: transparent; border: none; margin: 0px; padding: 0px; color: #a3b0c4; }
QProgressBar { background: transparent; border: none; } QProgressBar::chunk { background: #f5a524; }

QWidget#launcher { background: #03060c; }
QWidget#playShade { background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 rgba(3, 5, 13, 224), stop: 0.4 rgba(3, 5, 13, 140), stop: 0.64 rgba(3, 5, 13, 0), stop: 1 rgba(3, 5, 13, 0)); }
QWidget#playShadeBottom { background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgba(3, 5, 13, 0), stop: 1 rgba(3, 5, 13, 230)); }
QWidget#topShade { background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgba(3, 5, 13, 217), stop: 1 rgba(3, 5, 13, 0)); }
QWidget#chrome[dimmed=&quot;true&quot;] { background: rgba(3, 5, 13, 168); }

/* texts */
QLabel[role=&quot;brand&quot;] { color: #eef3fb; font-size: 23px; font-weight: 700; }
QLabel[role=&quot;overline&quot;] { color: #f5a524; font-size: 13px; font-weight: 600; }
QLabel[role=&quot;detailOver&quot;] { color: #f5a524; font-size: 12px; font-weight: 600; }
QLabel[role=&quot;h1&quot;] { color: #eef3fb; font-size: 42px; font-weight: 600; }
QLabel[role=&quot;h1&quot;][big=&quot;true&quot;] { font-size: 54px; }
QLabel[role=&quot;h2&quot;] { color: #eef3fb; font-size: 44px; font-weight: 600; }
QLabel[role=&quot;h3&quot;] { color: #eef3fb; font-size: 26px; font-weight: 600; }
QLabel[role=&quot;sub&quot;] { color: #a3b0c4; font-size: 15px; }
QLabel[role=&quot;body&quot;] { color: #a3b0c4; font-size: 16px; }
QLabel[role=&quot;bodySmall&quot;] { color: #a3b0c4; font-size: 15px; }
QLabel[role=&quot;heading&quot;] { color: #a3b0c4; font-size: 12px; font-weight: 600; }
QLabel[role=&quot;headingLarge&quot;] { color: #a3b0c4; font-size: 13px; font-weight: 600; }
QLabel[role=&quot;hint&quot;] { color: #657286; font-size: 13px; }
QLabel[role=&quot;foot&quot;] { color: #657286; font-size: 12px; font-weight: 600; }
QLabel[role=&quot;empty&quot;] { color: #a3b0c4; font-size: 15px; }
QLabel[role=&quot;faint13&quot;] { color: #657286; font-size: 13px; }
QLabel[role=&quot;build&quot;] { color: #a3b0c4; font-size: 13px; }
QLabel[role=&quot;count&quot;] { color: #a3b0c4; font-size: 14px; }
QLabel[role=&quot;crumbSep&quot;] { color: #657286; font-size: 14px; }
QLabel[role=&quot;rowLabel&quot;] { color: #a3b0c4; font-size: 14px; }
QLabel[role=&quot;rowValue&quot;] { color: #eef3fb; font-size: 14px; font-weight: 500; }
QLabel[role=&quot;chipText&quot;] { color: #eef3fb; font-size: 14px; }
QLabel[role=&quot;cardOver&quot;] { color: #657286; font-size: 11px; font-weight: 600; }
QLabel[role=&quot;cardTitle&quot;] { color: #eef3fb; font-size: 16px; font-weight: 600; }
QLabel[role=&quot;cardMeta&quot;] { color: #a3b0c4; font-size: 13px; }
QLabel[role=&quot;modInfo&quot;] { color: #a3b0c4; font-size: 13px; }
QLabel[role=&quot;modInfo&quot;][locked=&quot;true&quot;] { color: #f5a524; }
QLabel[role=&quot;skinName&quot;] { color: #eef3fb; font-size: 16px; font-weight: 600; }
QLabel[role=&quot;skinMeta&quot;] { color: #657286; font-size: 12px; }
QLabel[role=&quot;skinDesc&quot;] { color: #a3b0c4; font-size: 13px; }
QLabel[role=&quot;skinDesc&quot;][ok=&quot;false&quot;] { color: #f5a524; }
QLabel[role=&quot;activeMark&quot;] { color: #f5a524; font-size: 12px; font-weight: 600; }
QLabel[role=&quot;tag&quot;] { background: rgba(5, 10, 20, 179); border-radius: 11px; color: #eef3fb; font-size: 10px; font-weight: 600; padding: 0px 8px; }
QLabel[role=&quot;tag&quot;][cont=&quot;true&quot;] { color: #ffc65c; }
QLabel#toast { background: rgba(18, 28, 48, 209); border: 1px solid rgba(255, 255, 255, 61); border-radius: 21px; color: #eef3fb; font-size: 14px; padding: 0px 20px; }

/* dots: the tone property picks the colour */
QLabel[role=&quot;dot&quot;], QLabel[role=&quot;chipDot&quot;] { background: #3ddc97; border-radius: 3px; }
QLabel[tone=&quot;ok&quot;] { background: #3ddc97; }
QLabel[tone=&quot;info&quot;] { background: #5cc8ff; }
QLabel[tone=&quot;faint&quot;] { background: #657286; }
QLabel[tone=&quot;dim&quot;] { background: #a3b0c4; }
QLabel[tone=&quot;accent&quot;] { background: #f5a524; }

/* panels, rows, cards, chips */
QFrame[role=&quot;glass&quot;] { background: rgba(9, 15, 28, 168); border: 1px solid rgba(255, 255, 255, 23); border-radius: 14px; }
QFrame[role=&quot;rule&quot;] { background: rgba(255, 255, 255, 23); }
QFrame[role=&quot;statusRow&quot;] { border-bottom: 1px solid rgba(255, 255, 255, 23); }
QFrame[role=&quot;chip&quot;] { background: rgba(255, 255, 255, 18); border: 1px solid rgba(255, 255, 255, 23); border-radius: 16px; }
QFrame[role=&quot;card&quot;], QFrame[role=&quot;modCard&quot;] { background: rgba(9, 15, 28, 168); border: 1px solid rgba(255, 255, 255, 23); border-radius: 12px; }
QFrame[role=&quot;card&quot;]:hover, QFrame[role=&quot;modCard&quot;]:hover { background: rgba(18, 28, 48, 209); border: 1px solid rgba(255, 255, 255, 61); }
QFrame[role=&quot;modCard&quot;]:hover { border: 1px solid rgba(255, 255, 255, 23); }
QFrame[role=&quot;card&quot;][current=&quot;true&quot;] { border: 2px solid #f5a524; }
QFrame[role=&quot;modCard&quot;][on=&quot;true&quot;] { border: 1px solid rgba(245, 166, 36, 115); }
QFrame[role=&quot;skinRow&quot;] { background: rgba(255, 255, 255, 8); border: 1px solid rgba(255, 255, 255, 23); border-radius: 10px; }
QFrame[role=&quot;skinRow&quot;][current=&quot;true&quot;] { background: rgba(245, 166, 36, 31); border: 1px solid #f5a524; }
QFrame[role=&quot;filter&quot;] { background: rgba(255, 255, 255, 10); border: 1px solid rgba(255, 255, 255, 23); border-radius: 17px; }
QFrame[role=&quot;filter&quot;]:hover { background: rgba(255, 255, 255, 20); }
QFrame[role=&quot;filter&quot;][current=&quot;true&quot;] { background: rgba(245, 166, 36, 41); border: 1px solid #f5a524; }
QLabel[role=&quot;filterLabel&quot;] { color: #a3b0c4; font-size: 13px; font-weight: 600; }
QFrame[role=&quot;filter&quot;][current=&quot;true&quot;] QLabel[role=&quot;filterLabel&quot;] { color: #eef3fb; }
QLabel[role=&quot;filterCount&quot;] { color: #657286; font-size: 12px; }
QFrame[role=&quot;search&quot;] { background: rgba(255, 255, 255, 15); border: 1px solid rgba(255, 255, 255, 23); border-radius: 19px; }
QFrame[role=&quot;search&quot;][focused=&quot;true&quot;] { border: 1px solid #f5a524; }
QLineEdit[role=&quot;searchEdit&quot;] { font-size: 14px; }

/* buttons */
QPushButton[role=&quot;nav&quot;] { color: rgba(238, 243, 251, 140); font-size: 14px; font-weight: 600; margin: 21px 18px 18px 18px;
  border-bottom: 3px solid transparent; }
QPushButton[role=&quot;nav&quot;]:hover { color: rgba(238, 243, 251, 217); }
QPushButton[role=&quot;nav&quot;][current=&quot;true&quot;] { color: #eef3fb; border-bottom: 3px solid #f5a524; }
QPushButton[role=&quot;help&quot;] { border: 1px solid rgba(255, 255, 255, 61); border-radius: 18px; color: #eef3fb; font-size: 17px; font-weight: 600; }
QPushButton[role=&quot;help&quot;]:hover { background: rgba(255, 255, 255, 31); }
QPushButton[role=&quot;launch&quot;] { background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #ffc65c, stop: 1 #f5a524);
  border-radius: 11px; color: #1b1203; font-size: 20px; font-weight: 700; }
QPushButton[role=&quot;launch&quot;][buttonSize=&quot;mid&quot;] { font-size: 17px; }
QPushButton[role=&quot;launch&quot;][buttonSize=&quot;small&quot;] { font-size: 16px; }
QPushButton[role=&quot;ghost&quot;] { background: rgba(255, 255, 255, 10); border: 1px solid rgba(255, 255, 255, 41); border-radius: 11px;
  color: #eef3fb; font-size: 15px; font-weight: 600; padding: 0px 27px; }
QPushButton[role=&quot;ghost&quot;]:hover { background: rgba(255, 255, 255, 26); border: 1px solid rgba(255, 255, 255, 61); }
QPushButton[role=&quot;ghost&quot;][buttonSize=&quot;small&quot;] { font-size: 13px; }
QPushButton[role=&quot;ghost&quot;][star=&quot;true&quot;] { padding: 0px; }
QPushButton[role=&quot;link&quot;] { color: #f5a524; font-size: 12px; font-weight: 600; }
QPushButton[role=&quot;link&quot;]:hover { color: #ffbf58; }
QPushButton[role=&quot;link&quot;][tint=&quot;dim&quot;] { color: #a3b0c4; }
QPushButton[role=&quot;link&quot;][tint=&quot;dim&quot;]:hover { color: #ccdcf5; }
QPushButton[role=&quot;link&quot;][tint=&quot;text&quot;] { color: #eef3fb; }
QPushButton[role=&quot;link&quot;][tint=&quot;text&quot;]:hover { color: #ffffff; }
QPushButton[role=&quot;link&quot;][buttonSize=&quot;large&quot;] { font-size: 13px; }
QPushButton[role=&quot;link&quot;][buttonSize=&quot;crumb&quot;] { font-size: 14px; font-weight: 600; }
QPushButton[role=&quot;link&quot;]:disabled { color: #657286; }

/* the toggle switch: pictures in skin.qrc */
QCheckBox[role=&quot;toggle&quot;]::indicator { width: 46px; height: 26px; }
QCheckBox[role=&quot;toggle&quot;]::indicator:unchecked { image: url(:/horizon/images/toggle-off.png); }
QCheckBox[role=&quot;toggle&quot;]::indicator:checked { image: url(:/horizon/images/toggle-on.png); }
QCheckBox[role=&quot;toggle&quot;]::indicator:unchecked:disabled { image: url(:/horizon/images/toggle-off-disabled.png); }
QCheckBox[role=&quot;toggle&quot;]::indicator:checked:disabled { image: url(:/horizon/images/toggle-on-disabled.png); }
</string>
