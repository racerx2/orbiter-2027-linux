                    </property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QLabel" name="source2">
                    <property name="text">
                     <string>·  Near-Earth asteroids: two-body orbits from JPL element sets (Horizons and SBDB), one for each decade from 2000; positions are shown from 1995 to 2036, Apophis after its 2029 flyby to 2039.</string>
                    </property>
                    <property name="wordWrap">
                     <bool>true</bool>
                    </property>
                    <property name="role" stdset="0">
                     <string>small</string>
                    </property>
                    <property name="lineHeight" stdset="0">
                     <double>1.2</double>
                    </property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QLabel" name="source3">
                    <property name="text">
                     <string>·  Apophis flyby: JPL CNEOS close-approach data, orbit 220. No impact risk: off the JPL Sentry risk list since 2021.</string>
                    </property>
                    <property name="wordWrap">
                     <bool>true</bool>
                    </property>
                    <property name="role" stdset="0">
                     <string>small</string>
                    </property>
                    <property name="lineHeight" stdset="0">
                     <double>1.2</double>
                    </property>
                   </widget>
                  </item>
                  <item>
