  <property name="windowTitle">
   <string>Planetary Defense</string>
  </property>
  <property name="styleSheet">
   <string>/* Planetary Defense launcher style sheet.
   It begins with a reset: the classic pages' style sheet on the Launchpad reaches these widgets too. */
QWidget { background: transparent; border: none; border-radius: 0px; margin: 0px; padding: 0px; color: #e6f6ff;
  selection-background-color: #27d3ff; selection-color: #02121c; font-family: &quot;Noto Sans&quot;; font-size: 14px; font-weight: 400; }
QPushButton, QPushButton:hover, QPushButton:pressed, QPushButton:checked, QPushButton:disabled, QPushButton:focus,
QToolButton, QToolButton:hover, QToolButton:pressed, QToolButton:checked, QToolButton:disabled {
  background: transparent; border: none; border-radius: 0px; margin: 0px; padding: 0px; color: #e6f6ff; }
QCheckBox, QCheckBox:hover, QCheckBox:disabled { background: transparent; border: none; margin: 0px; padding: 0px; spacing: 0px; color: #e6f6ff; }
QLineEdit, QLineEdit:focus, QLineEdit:hover, QLineEdit:disabled { background: transparent; border: none; border-radius: 0px; margin: 0px; padding: 0px;
  color: #e6f6ff; selection-background-color: #27d3ff; selection-color: #02121c; placeholder-text-color: #5a7a8e; }
QScrollArea, QStackedWidget { background: transparent; border: none; }
QScrollBar:vertical, QScrollBar:horizontal { background: transparent; width: 0px; height: 0px; border: none; }
QGroupBox, QGroupBox::title { background: transparent; border: none; margin: 0px; padding: 0px; color: #8fb4c8; }
QProgressBar { background: transparent; border: none; } QProgressBar::chunk { background: #27d3ff; }

QWidget#launcher { background: #040a14; }

/* header and footer */
QLabel[role=&quot;brand&quot;] { color: #e6f6ff; font-size: 21px; font-weight: 700; }
QLabel[role=&quot;brandSub&quot;] { color: #27d3ff; font-size: 11px; font-weight: 600; }
QFrame[role=&quot;pill&quot;] { background: rgba(5, 15, 28, 217); border: 1px solid rgba(39, 211, 255, 56); border-radius: 13px; }
QLabel[role=&quot;pillText&quot;] { color: #e6f6ff; font-family: monospace; font-size: 11px; }
QLabel[role=&quot;foot&quot;] { color: #5a7a8e; font-family: monospace; font-size: 11px; }

/* panels: the glass panel's glow is the glow properties */
QFrame[role=&quot;glass&quot;] { background: rgba(7, 18, 34, 230); border: 2px solid rgba(39, 211, 255, 163); border-radius: 12px; }
QFrame[role=&quot;glass&quot;][edge=&quot;alert&quot;] { border: 2px solid rgba(255, 54, 70, 163); }
QFrame[role=&quot;glass&quot;][board=&quot;true&quot;] { background: rgba(23, 5, 10, 224); }
QFrame[role=&quot;rule&quot;] { background: rgba(39, 211, 255, 56); }
QFrame[role=&quot;boardRule&quot;] { background: rgba(255, 54, 69, 89); }
QLabel[role=&quot;panelTitle&quot;] { color: #e6f6ff; font-size: 13px; font-weight: 700; }
QLabel[role=&quot;panelInfo&quot;] { color: #8fb4c8; font-family: monospace; font-size: 11px; }
QFrame[role=&quot;titleRing&quot;] { border-radius: 7px; }

/* texts */
QLabel[role=&quot;missionTitle&quot;] { color: #e6f6ff; font-size: 24px; font-weight: 700; }
QLabel[role=&quot;missionTitle&quot;][low=&quot;true&quot;] { font-size: 20px; }
QLabel[role=&quot;desc&quot;] { color: #8fb4c8; font-size: 14px; }
QLabel[role=&quot;small&quot;] { color: #8fb4c8; font-size: 13px; }
QLabel[role=&quot;smallFaint&quot;] { color: #5a7a8e; font-size: 13px; }
QLabel[role=&quot;overline&quot;] { color: #27d3ff; font-size: 13px; font-weight: 600; }
QLabel[role=&quot;h2&quot;] { color: #e6f6ff; font-size: 30px; font-weight: 700; }
QLabel[role=&quot;sub&quot;] { color: #8fb4c8; font-size: 15px; }
QLabel[role=&quot;heading&quot;] { color: #8fb4c8; font-size: 12px; font-weight: 600; }
QLabel[role=&quot;detailOver&quot;] { color: #27d3ff; font-size: 12px; font-weight: 600; }
QLabel[role=&quot;h3&quot;] { color: #e6f6ff; font-size: 26px; font-weight: 600; }
QLabel[role=&quot;bodySmall&quot;] { color: #8fb4c8; font-size: 15px; }
QLabel[role=&quot;faint13&quot;] { color: #5a7a8e; font-size: 13px; }
QLabel[role=&quot;empty&quot;] { color: #8fb4c8; font-size: 15px; }
QLabel[role=&quot;count&quot;] { color: #8fb4c8; font-size: 14px; }
QLabel[role=&quot;crumbSep&quot;] { color: #5a7a8e; font-size: 14px; }
QLabel[role=&quot;rowLabel&quot;] { color: #8fb4c8; font-size: 14px; }
QLabel[role=&quot;rowValue&quot;] { color: #e6f6ff; font-size: 14px; font-weight: 500; }
QLabel[role=&quot;chipText&quot;] { color: #e6f6ff; font-size: 14px; }
QLabel[role=&quot;cardOver&quot;] { color: #5a7a8e; font-size: 11px; font-weight: 600; }
QLabel[role=&quot;cardTitle&quot;] { color: #e6f6ff; font-size: 16px; font-weight: 600; }
QLabel[role=&quot;cardMeta&quot;] { color: #8fb4c8; font-size: 13px; }
QLabel[role=&quot;modInfo&quot;] { color: #8fb4c8; font-size: 13px; }
QLabel[role=&quot;modInfo&quot;][locked=&quot;true&quot;] { color: #27d3ff; }
QLabel[role=&quot;skinName&quot;] { color: #e6f6ff; font-size: 16px; font-weight: 600; }
QLabel[role=&quot;skinMeta&quot;] { color: #5a7a8e; font-size: 12px; }
QLabel[role=&quot;skinDesc&quot;] { color: #8fb4c8; font-size: 13px; }
QLabel[role=&quot;skinDesc&quot;][ok=&quot;false&quot;] { color: #27d3ff; }
QLabel[role=&quot;activeMark&quot;] { color: #27d3ff; font-size: 12px; font-weight: 600; }
QLabel[role=&quot;concept&quot;] { color: #27d3ff; font-size: 12px; font-weight: 700; }
QLabel[role=&quot;mono&quot;] { color: #e6f6ff; font-family: monospace; font-size: 11px; }
QLabel[role=&quot;mono&quot;][small=&quot;true&quot;] { font-size: 10px; }
QLabel[role=&quot;monoDim&quot;] { color: #8fb4c8; font-family: monospace; font-size: 11px; }
QLabel[role=&quot;monoOk&quot;] { color: #39ff7a; font-family: monospace; font-size: 11px; }
QLabel[role=&quot;monoFaint&quot;] { color: #5a7a8e; font-family: monospace; font-size: 10px; }
QLabel[role=&quot;monoWarn&quot;] { color: #ffc23d; font-family: monospace; font-size: 10px; }
QLabel#toast { background: rgba(12, 28, 51, 240); border: 1px solid rgba(39, 211, 255, 140); border-radius: 21px; color: #e6f6ff; font-size: 14px; padding: 0px 20px; }

/* the flyby clock */
QFrame[role=&quot;tile&quot;] { background: rgba(0, 13, 8, 230); border: 1px solid rgba(39, 211, 255, 115); border-radius: 7px; }
QLabel[role=&quot;tileNum&quot;] { color: #39ff7a; font-family: monospace; font-size: 26px; font-weight: 700; }
QLabel[role=&quot;tileNum&quot;][compact=&quot;true&quot;] { font-size: 22px; }
QLabel[role=&quot;tileUnit&quot;] { color: #8fb4c8; font-size: 9px; font-weight: 700; }

/* system status and the mission board */
QLabel[role=&quot;readiness&quot;] { color: #8fb4c8; font-size: 12px; font-weight: 700; }
QLabel[role=&quot;readyPill&quot;] { background: rgba(0, 0, 0, 89); border: 1px solid #39ff7a; border-radius: 12px; color: #39ff7a;
  font-family: monospace; font-size: 11px; font-weight: 700; padding: 0px 11px; }
QLabel[role=&quot;readyPill&quot;][warn=&quot;true&quot;] { border: 1px solid #ffc23d; color: #ffc23d; }
QLabel[role=&quot;boardHead&quot;] { color: #8fb4c8; font-size: 10px; font-weight: 700; }
QFrame[role=&quot;boardRow&quot;] { border: 1px solid transparent; border-radius: 5px; }
QFrame[role=&quot;boardRow&quot;]:hover { background: rgba(255, 255, 255, 13); }
QFrame[role=&quot;boardRow&quot;][sel=&quot;true&quot;] { background: rgba(255, 54, 69, 56); border: 1px solid rgba(255, 54, 69, 153); }
QLabel[role=&quot;boardName&quot;] { color: #e6f6ff; font-family: monospace; font-size: 12px; }
QLabel[role=&quot;boardName&quot;][sel=&quot;true&quot;] { font-weight: 700; }
QLabel[role=&quot;boardTag&quot;] { color: #5a7a8e; font-size: 9px; font-weight: 700; }
QLabel[role=&quot;boardTag&quot;][cont=&quot;true&quot;] { color: #27d3ff; }
QLabel[role=&quot;boardLine&quot;] { color: #8fb4c8; font-family: monospace; font-size: 10px; }
QLabel[role=&quot;boardLine&quot;][ink=&quot;warn&quot;] { color: #ffc23d; }
QLabel[role=&quot;boardLine&quot;][ink=&quot;ok&quot;] { color: #39ff7a; }

/* dots: the tone property picks the colour */
QLabel[role=&quot;dot&quot;] { border-radius: 3px; }
QLabel[role=&quot;chipDot&quot;] { border-radius: 3px; }
QLabel[role=&quot;pillDot&quot;] { border-radius: 4px; }
QLabel[role=&quot;titleDot&quot;] { border-radius: 4px; }
QLabel[tone=&quot;ok&quot;] { background: rgb(57, 255, 122); }
QFrame[role=&quot;titleRing&quot;][tone=&quot;ok&quot;] { border: 1px solid rgba(57, 255, 122, 89); }
QLabel[tone=&quot;info&quot;] { background: rgb(42, 139, 255); }
QFrame[role=&quot;titleRing&quot;][tone=&quot;info&quot;] { border: 1px solid rgba(42, 139, 255, 89); }
QLabel[tone=&quot;faint&quot;] { background: rgb(90, 122, 142); }
QFrame[role=&quot;titleRing&quot;][tone=&quot;faint&quot;] { border: 1px solid rgba(90, 122, 142, 89); }
QLabel[tone=&quot;dim&quot;] { background: rgb(143, 180, 200); }
QFrame[role=&quot;titleRing&quot;][tone=&quot;dim&quot;] { border: 1px solid rgba(143, 180, 200, 89); }
QLabel[tone=&quot;accent&quot;] { background: rgb(39, 211, 255); }
QFrame[role=&quot;titleRing&quot;][tone=&quot;accent&quot;] { border: 1px solid rgba(39, 211, 255, 89); }
QLabel[tone=&quot;warn&quot;] { background: rgb(255, 194, 61); }
QFrame[role=&quot;titleRing&quot;][tone=&quot;warn&quot;] { border: 1px solid rgba(255, 194, 61, 89); }
QLabel[tone=&quot;alert&quot;] { background: rgb(255, 54, 70); }
QFrame[role=&quot;titleRing&quot;][tone=&quot;alert&quot;] { border: 1px solid rgba(255, 54, 70, 89); }

/* rows, cards, chips */
QFrame[role=&quot;statusRow&quot;] { border-bottom: 1px solid rgba(39, 211, 255, 56); }
QFrame[role=&quot;chip&quot;] { background: rgba(255, 255, 255, 18); border: 1px solid rgba(39, 211, 255, 56); border-radius: 16px; }
QFrame[role=&quot;card&quot;], QFrame[role=&quot;modCard&quot;] { background: rgba(7, 18, 34, 230); border: 1px solid rgba(39, 211, 255, 56); border-radius: 12px; }
QFrame[role=&quot;card&quot;]:hover, QFrame[role=&quot;modCard&quot;]:hover { background: rgba(12, 28, 51, 240); border: 1px solid rgba(39, 211, 255, 140); }
QFrame[role=&quot;modCard&quot;]:hover { border: 1px solid rgba(39, 211, 255, 56); }
QFrame[role=&quot;card&quot;][current=&quot;true&quot;] { border: 2px solid #27d3ff; }
QFrame[role=&quot;modCard&quot;][on=&quot;true&quot;] { border: 1px solid rgba(39, 211, 255, 115); }
QFrame[role=&quot;skinRow&quot;] { background: rgba(255, 255, 255, 8); border: 1px solid rgba(39, 211, 255, 56); border-radius: 10px; }
QFrame[role=&quot;skinRow&quot;][current=&quot;true&quot;] { background: rgba(39, 211, 255, 31); border: 1px solid #27d3ff; }
QFrame[role=&quot;filter&quot;] { background: rgba(255, 255, 255, 10); border: 1px solid rgba(39, 211, 255, 56); border-radius: 17px; }
QFrame[role=&quot;filter&quot;]:hover { background: rgba(255, 255, 255, 20); }
QFrame[role=&quot;filter&quot;][current=&quot;true&quot;] { background: rgba(39, 211, 255, 41); border: 1px solid #27d3ff; }
QLabel[role=&quot;filterLabel&quot;] { color: #8fb4c8; font-size: 13px; font-weight: 600; }
QFrame[role=&quot;filter&quot;][current=&quot;true&quot;] QLabel[role=&quot;filterLabel&quot;] { color: #e6f6ff; }
QLabel[role=&quot;filterCount&quot;] { color: #5a7a8e; font-size: 12px; }
QFrame[role=&quot;search&quot;] { background: rgba(255, 255, 255, 15); border: 1px solid rgba(39, 211, 255, 56); border-radius: 19px; }
QFrame[role=&quot;search&quot;][focused=&quot;true&quot;] { border: 1px solid #27d3ff; }
QLineEdit[role=&quot;searchEdit&quot;] { font-size: 14px; }

/* buttons */
QPushButton[role=&quot;nav&quot;] { background: rgba(5, 15, 28, 217); border: 2px solid rgba(39, 211, 255, 115); border-radius: 10px; color: #e6f6ff;
  font-size: 13px; font-weight: 700; padding: 0px 15px; }
QPushButton[role=&quot;nav&quot;]:hover { background: rgba(39, 211, 255, 26); border: 2px solid rgba(39, 211, 255, 173); }
QPushButton[role=&quot;nav&quot;][edge=&quot;alert&quot;] { border: 2px solid rgba(255, 54, 70, 115); }
QPushButton[role=&quot;nav&quot;][edge=&quot;alert&quot;]:hover { border: 2px solid rgba(255, 54, 70, 173); }
QPushButton[role=&quot;nav&quot;][current=&quot;true&quot;] { background: #2a8bff; border: 2px solid rgba(85, 166, 255, 191); color: #ffffff; }
QPushButton[role=&quot;launch&quot;] { background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #55a6ff, stop: 1 #2a8bff);
  border: 2px solid rgba(127, 230, 255, 191); border-radius: 10px; color: #ffffff; font-size: 17px; font-weight: 700; }
QPushButton[role=&quot;launch&quot;]:hover { background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #4fa8ff, stop: 1 #2a8bff); }
QPushButton[role=&quot;launch&quot;][buttonSize=&quot;mid&quot;] { font-size: 15px; }
QPushButton[role=&quot;launch&quot;][buttonSize=&quot;small&quot;] { font-size: 16px; }
QPushButton[role=&quot;ghost&quot;] { background: rgba(5, 15, 28, 217); border: 1px solid rgba(39, 211, 255, 56); border-radius: 10px;
  color: #e6f6ff; font-size: 15px; font-weight: 600; padding: 0px 27px; }
QPushButton[role=&quot;ghost&quot;]:hover { background: rgba(39, 211, 255, 31); border: 1px solid rgba(39, 211, 255, 140); }
QPushButton[role=&quot;ghost&quot;][buttonSize=&quot;small&quot;] { font-size: 13px; }
QPushButton[role=&quot;ghost&quot;][star=&quot;true&quot;] { padding: 0px; }
QPushButton[role=&quot;link&quot;] { color: #27d3ff; font-size: 12px; font-weight: 600; }
QPushButton[role=&quot;link&quot;]:hover { color: #66e0ff; }
QPushButton[role=&quot;link&quot;][tint=&quot;dim&quot;] { color: #8fb4c8; }
QPushButton[role=&quot;link&quot;][tint=&quot;dim&quot;]:hover { color: #b2e1fa; }
QPushButton[role=&quot;link&quot;][tint=&quot;text&quot;] { color: #e6f6ff; }
QPushButton[role=&quot;link&quot;][tint=&quot;text&quot;]:hover { color: #ffffff; }
QPushButton[role=&quot;link&quot;][buttonSize=&quot;crumb&quot;] { font-size: 14px; font-weight: 600; }
QPushButton[role=&quot;link&quot;]:disabled { color: #5a7a8e; }

/* the toggle switch: pictures in skin.qrc */
QCheckBox[role=&quot;toggle&quot;]::indicator { width: 46px; height: 26px; }
QCheckBox[role=&quot;toggle&quot;]::indicator:unchecked { image: url(:/pd/images/toggle-off.png); }
QCheckBox[role=&quot;toggle&quot;]::indicator:checked { image: url(:/pd/images/toggle-on.png); }
QCheckBox[role=&quot;toggle&quot;]::indicator:unchecked:disabled { image: url(:/pd/images/toggle-off-disabled.png); }
QCheckBox[role=&quot;toggle&quot;]::indicator:checked:disabled { image: url(:/pd/images/toggle-on-disabled.png); }
</string>
