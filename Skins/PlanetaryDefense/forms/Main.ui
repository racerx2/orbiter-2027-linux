                  <item>
                   <widget class="QLabel" name="source1">
                    <property name="text">
                     <string>·  Planets: E. M. Standish, Keplerian elements for approximate positions of the major planets (JPL), valid 1800–2050.</string>
                    </property>
                    <property name="wordWrap">
                     <bool>true</bool>
                    </property>
                    <property name="role" stdset="0">
